{
  "name": "esports-prize-validator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:backend": "cd backend && ../.venv/bin/python -m uvicorn src.main:app --reload",
    "dev:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "check:backend": ".venv/bin/python -m pip check",
    "dev:public": "npm --prefix frontend-public start",
    "build:public": "npm --prefix frontend-public run build",
    "test:public": "npm --prefix frontend-public test -- --runInBand",
    "dev:worker": "cd backend && ../.venv/bin/python -m celery -A src.celery_app:app worker --loglevel=info --concurrency=2",
    "dev:beat": "cd backend && ../.venv/bin/python -m celery -A src.celery_app:app beat --loglevel=info --schedule=/tmp/esports-celerybeat-schedule"
  }
}
